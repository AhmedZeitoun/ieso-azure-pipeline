{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "Recurrence": {
      "type": "Recurrence",
      "description": "Runs every 24 hours",
      "recurrence": {
        "frequency": "Hour",
        "interval": 24,
        "timeZone": "Eastern Standard Time"
      },
      "evaluatedRecurrence": {
        "frequency": "Hour",
        "interval": 24,
        "timeZone": "Eastern Standard Time"
      },
      "conditions": []
    }
  },
  "actions": {
    "HTTP": {
      "type": "Http",
      "runAfter": {},
      "inputs": {
        "method": "GET",
        "uri": "https://reports-public.ieso.ca/public/GenOutputbyFuelHourly/PUB_GenOutputbyFuelHourly.xml"
      },
      "runtimeConfiguration": {
        "contentTransfer": {
          "transferMode": "Chunked"
        }
      }
    },
    "Create_blob_(V2)": {
      "type": "ApiConnection",
      "runAfter": {
        "HTTP": [
          "Succeeded"
        ]
      },
      "inputs": {
        "body": "@body('HTTP')",
        "headers": {
          "ReadFileMetadataFromServer": true
        },
        "host": {
          "connection": {
            "name": "@parameters('$connections')['azureblob']['connectionId']"
          }
        },
        "method": "post",
        "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('AccountNameFromSettings'))}/files",
        "queries": {
          "folderPath": "/bronze/ieso_raw/daily/",
          "name": "@concat('ieso_hourly_', utcNow('yyyyMMdd_HHmmss'), '.xml')",
          "queryParametersSingleEncoded": true
        }
      },
      "runtimeConfiguration": {
        "contentTransfer": {
          "transferMode": "Chunked"
        }
      }
    }
  },
  "outputs": {}
}
